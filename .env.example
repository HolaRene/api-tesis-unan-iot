# Entorno de ejecución: development | production | test
NODE_ENV=development

# Puerto en el que escuchará el servidor Express
PORT=3000

# Orígenes CORS permitidos, separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgresql://postgres:cambia-esta-clave@localhost:5432/monitoreo_iot

# Número máximo de conexiones en el pool de PostgreSQL
DB_POOL_MAX=10

# Secreto para firmar tokens JWT (cambiar en producción)
JWT_SECRET=cambia-este-secreto-por-uno-seguro

# Tiempo de expiración del token de acceso (ej: 15m, 7d)
JWT_EXPIRES_IN=7d

# Secreto para firmar cookies
COOKIE_SECRET=cambia-este-secreto-de-cookies

# Límite de solicitudes por ventana de tiempo (rate limit)
# Ventana en milisegundos (15 minutos por defecto)
RATE_LIMIT_WINDOW_MS=900000

# Número máximo de solicitudes por ventana y por IP
RATE_LIMIT_MAX=100
